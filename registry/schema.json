{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/araminian/skill-store/main/registry/schema.json",
  "title": "SkillStoreRegistry",
  "description": "Schema for skill-store stacks and community registry",
  "type": "object",
  "required": ["version", "stacks"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "category", "skills"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique canonical identifier e.g. frontend/nextjs",
            "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)+$"
          },
          "name": {
            "type": "string",
            "description": "Human-readable display name"
          },
          "description": {
            "type": "string",
            "description": "Summary of what this stack provides"
          },
          "category": {
            "type": "string",
            "description": "Dynamic open category name e.g. frontend, backend, devops, security, ai, data, workflow"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "extends": {
            "type": "string",
            "description": "Optional parent stack ID to inherit skills from"
          },
          "detect": {
            "type": "object",
            "description": "Future-proof auto-detection heuristics",
            "properties": {
              "files": {
                "type": "array",
                "items": { "type": "string" }
              },
              "dependencies": {
                "type": "array",
                "items": { "type": "string" }
              },
              "languages": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "source": { "type": "string", "description": "GitHub owner/repo or git URL" },
                "subpath": { "type": "string" },
                "ref": { "type": "string" },
                "optional": { "type": "boolean", "default": false },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
