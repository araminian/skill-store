{
  "name": "@araminian/skill-store",
  "version": "1.0.0",
  "description": "Centralized agent skill manager with intelligent project symlinking and reference tracking",
  "type": "module",
  "bin": {
    "skill-store": "./bin/cli.mjs",
    "skstore": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --no-warnings --loader ts-node/esm src/cli.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "skills",
    "skill-store",
    "agent-skills",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex"
  ],
  "author": "Armin Aminian",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/araminian/skill-store.git"
  },
  "homepage": "https://github.com/araminian/skill-store#readme",
  "bugs": {
    "url": "https://github.com/araminian/skill-store/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
